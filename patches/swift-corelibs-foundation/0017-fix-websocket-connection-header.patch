diff --git a/Sources/FoundationNetworking/URLSession/WebSocket/WebSocketURLProtocol.swift b/Sources/FoundationNetworking/URLSession/WebSocket/WebSocketURLProtocol.swift
index e35612dd..db924d71 100644
--- a/Sources/FoundationNetworking/URLSession/WebSocket/WebSocketURLProtocol.swift
+++ b/Sources/FoundationNetworking/URLSession/WebSocket/WebSocketURLProtocol.swift
@@ -201,4 +201,15 @@ internal class _WebSocketURLProtocol: _HTTPURLProtocol {
             transferCompleted(withError: error)
         }
     }
+
+    // Don’t send a "Connection" header for ws:// connections.
+    // The WebSocket handshake requires "Connection: Upgrade",
+    // which libcurl generates automatically.
+    // Since libcurl 8.15.0, client-provided "Connection" headers
+    // are no longer overridden, so we must strip them all.
+    override var curlHeadersToSet: [(String, String)] {
+        var result = super.curlHeadersToSet
+        result.removeAll { $0.0 == "Connection" }
+        return result
+    }
 }
